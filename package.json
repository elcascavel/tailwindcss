{
  "name": "@elcascavel/tailwind-dracula",
  "version": "1.0.1",
  "description": "A Tailwind theme that enables the use of the Dracula colour palette.",
  "main": "dist/tailwind-dracula.css",
  "scripts": {
    "prepare": "npm run build",
    "build": "sass --no-source-map src/theme.scss dracula.css",
    "watch": "sass --no-source-map --watch src/dracula.scss dracula.css"
  },
  "files": [
    "dracula.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elcascavel/tailwindcss.git"
  },
  "keywords": [
    "package",
    "tailwind",
    "tailwindcss",
    "dracula",
    "colors",
    "theme"
  ],
  "author": "Simão Amaral; Original Author: Nick Graffis",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dracula/tailwind/issues"
  },
  "peerDependencies": {
    "tailwindcss": "4.x",
    "sass": "^1.89.1"
  }
}
